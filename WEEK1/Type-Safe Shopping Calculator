public class ShoppingCalculator {
    public static void main(String[] args) {
        String storeName = "Grace's Mini Mart";
        int quantity = 5;
        double unitPrice = 149.75;
        double totalCost = quantity * unitPrice;

        /*
 * totalCost should be a double rather than an int because the 
 * unitPrice is a double and the total cost may include decimal 
 * values, such as cents. Declaring totalCost as an int would 
 * remove the decimal part of the result and could lead to an 
 * inaccurate total cost.
 */

        System.out.println("--- Purchase Summary ---");
        System.out.println("Store Name:  " + storeName);
        System.out.println("Quantity:    " + quantity);
        System.out.println("Unit Price:  ₱" + unitPrice);
        System.out.println("Total Cost:  ₱" + totalCost);
    }
}
